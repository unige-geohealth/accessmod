{
  "name": "accessmod",
  "description": "AccessMod build script",
  "version": "5.9.2-beta.5",
  "type": "module",
  "scripts": {
    "check:js": "npm run format:check && npm run lint",
    "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version": "node version.js",
    "version:dry": "node version.js --dry-run",
    "test": "sh ./test.sh",
    "test:local": "sh ./test_local.sh",
    "test:ui": "sh ./tests/ui/run.sh",
    "test:ui:live": "sh ./tests/ui/run.sh --live",
    "test:qemu": "bash qemu/tests/run.sh",
    "dev": "docker compose exec -T am5_dev sh -c \"echo 'source(\\\"run.r\\\")' | R --no-save\"",
    "dev:r": "docker compose exec -T am5_dev R --no-save",
    "prepare": "husky"
  },
  "keywords": [
    "build scripts",
    "semver",
    "accessmod",
    "version",
    "test"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
